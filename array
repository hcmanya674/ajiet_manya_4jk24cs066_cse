class Main {
    public static void main(String[] args) {
      int num=121;
      int n=num;
      int rev=0;
       
      while (num != 0) {
            int digit = num % 10;
            rev = rev * 10 + digit;
            num = num / 10;
        }

      if(n==rev)
         System.out.println("palindrome");
      else
        System.out.println("not palindrome");
    }
}
